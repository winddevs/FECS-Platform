# Settings that depend on the domain. Copy the lines you need into
# apps/medusa/.env and apps/store/.env (or your secret manager / orchestrator).

# ---- apps/medusa (Medusa API at https://api.bibaestudios.com) ---------------
NODE_ENV=production
BACKEND_URL=https://api.bibaestudios.com
STORE_CORS=https://bibaestudios.com,https://www.bibaestudios.com
ADMIN_CORS=https://api.bibaestudios.com
AUTH_CORS=https://api.bibaestudios.com,https://bibaestudios.com,https://www.bibaestudios.com
# Links inside Messenger chats and emails point at the shop.
STOREFRONT_URL=https://bibaestudios.com
# Payload CMS lives inside the storefront.
PAYLOAD_SERVER_URL=https://bibaestudios.com
# Email: Resend over SMTP (see docs/operations.md). Sender on a verified domain.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
EMAIL_FROM="FECS Fashion <no-reply@bibaestudios.com>"
# SMTP_PASSWORD=<Resend API key>   <- secret: not in git

# ---- apps/store (Next.js at https://bibaestudios.com) -----------------------
# The storefront server calls Medusa directly on the same machine.
MEDUSA_BACKEND_URL=http://127.0.0.1:9000
NEXT_PUBLIC_BASE_URL=https://bibaestudios.com
NEXT_PUBLIC_SERVER_URL=https://bibaestudios.com
NEXT_PUBLIC_DEFAULT_REGION=vn
PAYLOAD_SERVER_URL=https://bibaestudios.com
EMAIL_FROM="FECS Fashion <no-reply@bibaestudios.com>"
