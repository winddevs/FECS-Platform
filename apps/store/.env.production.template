# PRODUCTION values for apps/store (https://bibaestudios.com).
#
# Do NOT copy this file to apps/store/.env on your machine: that file is for local
# development and is built from .env.template. The production .env lives only on the
# store droplet (/opt/fecs/store/.env). `scripts/deploy.sh setup store` creates it with
# generated secrets; this file lists what must differ from local.
#
#   scripts/deploy.sh env store                show it (secrets hidden)
#   scripts/deploy.sh set-env store KEY        change one value
#
# NEXT_PUBLIC_* values are compiled into the browser bundle at build time: change
# them, then run `scripts/deploy.sh release store` again.
# `release store` refuses to build when a public URL below points at localhost.

NODE_ENV=production

# ---- site addresses ----
NEXT_PUBLIC_BASE_URL=https://bibaestudios.com
NEXT_PUBLIC_SERVER_URL=https://bibaestudios.com
NEXT_PUBLIC_WWW_URL=https://bibaestudios.com
PAYLOAD_SERVER_URL=https://bibaestudios.com
NEXT_PUBLIC_DEFAULT_REGION=vn

# ---- Medusa: backend droplet, private network (never the public ecom. address:
# every shopper would share the store droplet's IP in nginx's sign-in rate limit) ----
MEDUSA_BACKEND_URL=http://<backend private IP>:9000
# Filled by: scripts/deploy.sh publishable-key
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
MEDUSA_PUBLISHABLE_KEY=

# ---- Payload CMS ----
PAYLOAD_SECRET=<generated>
PREVIEW_SECRET=<generated>
REVALIDATE_SECRET=<generated>
CRON_SECRET=<generated>
# Database and Redis are on the backend droplet, private network.
DATABASE_URL=postgresql://ecommerce_admin:<password>@<backend private IP>:5432/ecommerce_cms
REDIS_URL=redis://:<password>@<backend private IP>:6379

# ---- media (MinIO now; Cloudflare R2 later, see docs/deploy-digitalocean.md 6.2) ----
S3_ENDPOINT=https://s3.bibaestudios.com
S3_FILE_URL=https://s3.bibaestudios.com/ecommerce-media
S3_BUCKET=ecommerce-media
S3_REGION=us-east-1
# Resized WebP images. Leave empty until the img. host works (docs/deploy-digitalocean.md 6.1).
NEXT_PUBLIC_IMGPROXY_URL=

# ---- captcha: required in production, missing values reject every protected form ----
NEXT_PUBLIC_FCAPTCHA_ORIGIN=https://captcha.bibaestudios.com
NEXT_PUBLIC_FCAPTCHA_SITE_KEY=storefront
FCAPTCHA_ORIGIN=http://fcaptcha:3000
FCAPTCHA_VERIFY_SECRET=<generated>

# ---- email (Resend over SMTP) ----
SMTP_HOST=smtp.resend.com
SMTP_PORT=2465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=<Resend API key>
EMAIL_FROM="bibaestudios <no-reply@bibaestudios.com>"
