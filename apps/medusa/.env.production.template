# PRODUCTION values for apps/medusa (https://ecom.bibaestudios.com).
#
# Do NOT copy this file to apps/medusa/.env on your machine: that file is for local
# development and is built from .env.template. The production .env lives only on the
# backend droplet (/opt/fecs/backend/.env). `scripts/deploy.sh setup backend` creates
# it with generated secrets; this file lists what must differ from local.
#
#   scripts/deploy.sh env backend              show it (secrets hidden)
#   scripts/deploy.sh set-env backend KEY      change one value
#
# `scripts/deploy.sh release backend` refuses to build when a public URL below
# points at localhost.

NODE_ENV=production

# ---- public addresses (they appear in emails, so they must not be localhost) ----
# Staff invites and admin password-reset links start with BACKEND_URL.
BACKEND_URL=https://ecom.bibaestudios.com
# Customer password-reset and Messenger links start with STOREFRONT_URL.
STOREFRONT_URL=https://bibaestudios.com
STORE_CORS=https://bibaestudios.com,https://www.bibaestudios.com
ADMIN_CORS=https://ecom.bibaestudios.com
AUTH_CORS=https://ecom.bibaestudios.com,https://bibaestudios.com,https://www.bibaestudios.com

# ---- Payload CMS: the store droplet, private network ----
PAYLOAD_SERVER_URL=http://<store private IP>:8000
PAYLOAD_USER_COLLECTION=users
PAYLOAD_API_KEY=<generated by deploy.sh setup>

# ---- secrets: generated by deploy.sh setup, never reuse the local ones ----
JWT_SECRET=<24+ characters>
COOKIE_SECRET=<24+ characters>
METRICS_TOKEN=<16+ characters>

# ---- services: container names inside the backend compose network ----
# (docker-compose.yml sets DATABASE_URL and REDIS_URL itself)
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=<generated>
MEILISEARCH_PRODUCT_INDEX=products

# ---- file storage: MinIO behind https://s3.bibaestudios.com ----
S3_ENDPOINT=https://s3.bibaestudios.com
S3_FILE_URL=https://s3.bibaestudios.com/ecommerce-medusa
S3_BUCKET=ecommerce-medusa
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ---- email (Resend over SMTP). Medusa refuses to start without a password and sender ----
SMTP_HOST=smtp.resend.com
SMTP_PORT=2465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=<Resend API key>
EMAIL_FROM="bibaestudios <no-reply@bibaestudios.com>"
EMAIL_DEFAULT_LOCALE=vi
INVOICE_DEFAULT_LOCALE=vi
EMAIL_SUPPORT_ADDRESS=support@bibaestudios.com

# ---- must stay OFF/unset in production ----
# LOCAL_STACK is only for the local demo stack (it switches off real providers and
# the localhost checks). CARRIER_SANDBOX and CHANNEL_SANDBOX call fake providers.
# LOCAL_STACK=
# CARRIER_SANDBOX=false
# CHANNEL_SANDBOX=false
# SKIP_SECRET_CHECK=false
