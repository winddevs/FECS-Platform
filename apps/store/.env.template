# LOCAL DEVELOPMENT values for apps/store. Copy to apps/store/.env.
# Production values are in .env.production.template. Never copy those here,
# and never copy this file to a server: its URLs point at localhost.
NODE_ENV=development

# Your Medusa backend URL
MEDUSA_BACKEND_URL=http://localhost:9100

# Your publishable key for sales channels
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
MEDUSA_PUBLISHABLE_KEY=

# Medusa admin credentials (for server-side auth)
MEDUSA_ADMIN_EMAIL=admin@medusajs.com
MEDUSA_ADMIN_PASSWORD=

# Your store URL
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Public server URL (used for sitemaps)
NEXT_PUBLIC_SERVER_URL=http://localhost:8000

# Default region or default country code
NEXT_PUBLIC_DEFAULT_REGION=vn

# Stripe public key
NEXT_PUBLIC_STRIPE_KEY=

# WWW URL for sitemap/robots
NEXT_PUBLIC_WWW_URL=

# Payload CMS connection
PAYLOAD_SECRET=
DATABASE_URL=postgresql://ecommerce_admin:password@localhost:5555/ecommerce_cms

# Payload CMS server URL
PAYLOAD_SERVER_URL=http://localhost:8000

# Preview secret (for Payload CMS live preview)
PREVIEW_SECRET=

# Next.js revalidation secret (for Payload CMS webhooks)
REVALIDATE_SECRET=

# Facebook domain verification (for meta tags)
FACEBOOK_DOMAIN_VERIFICATION=

# Email over SMTP (Resend: host smtp.resend.com, port 465, user "resend",
# password = your Resend API key). Port 587/2587 use STARTTLS (SMTP_SECURE=false).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM=

# imgproxy: resizes and converts images (WebP) from the bucket. Leave empty to
# let Next.js resize them itself.
#   local:  NEXT_PUBLIC_IMGPROXY_URL=http://localhost:8081
#   prod:   NEXT_PUBLIC_IMGPROXY_URL=https://img.bibaestudios.com
# It is baked into the browser bundle at build time.
NEXT_PUBLIC_IMGPROXY_URL=

# S3-compatible storage (MinIO, R2, ...). Payload uploads media here directly.
# Local dev (docker compose up -d minio minio-init in ./docker):
#   S3_ENDPOINT=http://localhost:9000  S3_FILE_URL=http://localhost:9000/ecommerce-media
#   S3_BUCKET=ecommerce-media  S3_REGION=us-east-1
#   S3_ACCESS_KEY_ID=minioadmin  S3_SECRET_ACCESS_KEY=minioadmin
# MinIO example:
#   S3_ENDPOINT=https://minio.example.com
#   S3_FILE_URL=https://minio.example.com/<bucket>   (public read URL, includes bucket)
#   S3_REGION=us-east-1                              (MinIO default region)
NEXT_PUBLIC_R2_HOSTNAME=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=

# Shared sign-in / sign-up rate limits (per account). With this set, every
# storefront instance counts in the same Redis and a restart keeps the counts.
# Leave empty in development: counts then stay in memory, per process.
REDIS_URL=

# FCaptcha (self-hosted captcha) protects the sign-in, sign-up and CMS forms.
# Local: docker compose up -d fcaptcha (in ./docker), then use the values below.
# Leave all four empty in development to skip the check. In production the
# check always runs, and missing values reject every protected form.
# The two NEXT_PUBLIC values are public and baked into the browser bundle at
# build time. FCAPTCHA_VERIFY_SECRET must stay server-side.
#   NEXT_PUBLIC_FCAPTCHA_ORIGIN: URL the browser loads the widget from
#   FCAPTCHA_ORIGIN:            URL the storefront server uses to verify tokens
NEXT_PUBLIC_FCAPTCHA_ORIGIN=
NEXT_PUBLIC_FCAPTCHA_SITE_KEY=
FCAPTCHA_ORIGIN=
FCAPTCHA_VERIFY_SECRET=
