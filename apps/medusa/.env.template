# Medusa
JWT_SECRET=
COOKIE_SECRET=
DATABASE_URL=postgresql://ecommerce_admin:password@localhost:5555/ecommerce_medusa
BACKEND_URL=http://localhost:9100
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9100,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9100,http://localhost:8000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs
MEDUSA_ADMIN_ONBOARDING_NEXTJS_DIRECTORY=store

# Language of API error messages when the request sends neither x-locale nor
# Accept-Language (vi | en). Keep en so existing API clients see English.
DEFAULT_API_LOCALE=en
# Payload CMS
PAYLOAD_SERVER_URL=http://localhost:8000
PAYLOAD_API_KEY=
PAYLOAD_USER_COLLECTION=users

# Algolia search
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_PRODUCT_INDEX_NAME=

# S3/R2-compatible storage
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=

# Analytics
POSTHOG_EVENTS_API_KEY=
POSTHOG_HOST=https://en.i.posthog.com

# Notifications (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Email/invoice language when the order has no supported locale (vi | en)
EMAIL_DEFAULT_LOCALE=vi
INVOICE_DEFAULT_LOCALE=vi
# Support contact shown in the order confirmation footer
EMAIL_SUPPORT_ADDRESS=support@fecs.vn

# Telemetry
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Fashion platform (ERP + commerce + fulfillment + social)
# See docs/operations.md for what each setting does and who should set it.
# ---------------------------------------------------------------------------

# Process role: server (HTTP only) | worker (jobs/subscribers only) | shared (both, dev)
MEDUSA_WORKER_MODE=shared

# Postgres pool per pod. replicas x DB_POOL_MAX must stay below max_connections.
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# Feature flags (all default OFF). Enable one integration at a time.
MANUFACTURING_ENABLED=false      # FG ship-out on fulfillment, MTO pipeline prerequisites
MTO_ENABLED=false                # made-to-order production requests from orders
MTO_PAYMENT_GATE=captured        # captured | authorized | none
FG_SYNC_TO_MEDUSA_ENABLED=false  # push the sellable projection into Medusa inventory
JT_FULFILLMENT_ENABLED=false
JT_AUTO_CREATE_SHIPMENT=false
JT_TRACKING_CALLBACK_ENABLED=false
JT_RECONCILIATION_ENABLED=false
META_MESSENGER_ENABLED=false
META_SHIPMENT_NOTIFICATION_ENABLED=false
AGENT_READ_TOOLS_ENABLED=false
AGENT_STATE_CHANGE_ENABLED=false

# Local development: never call real providers.
CARRIER_SANDBOX=false
CHANNEL_SANDBOX=false
# HMAC secret the sandbox providers use to verify webhooks (staging/CI only).
SANDBOX_WEBHOOK_SECRET=

# J&T (credentials come from your J&T account manager)
JT_API_BASE_URL=
JT_API_ACCOUNT=
JT_PRIVATE_KEY=
JT_WEBHOOK_SECRET=
CARRIER_SENDER_NAME=
CARRIER_SENDER_PHONE=
CARRIER_SENDER_ADDRESS=
CARRIER_SENDER_PROVINCE=
CARRIER_COD_ENABLED=false

# Meta Messenger. Single page: META_PAGE_ID + META_PAGE_ACCESS_TOKEN.
# Several pages: META_PAGES='{"<page_id>":"<token>"}'
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
SOCIAL_DEFAULT_LOCALE=vi
SOCIAL_LINK_SECRET=
SOCIAL_REGION_ID=
SOCIAL_SALES_CHANNEL_ID=
STOREFRONT_URL=http://localhost:8000

# Returns
RETURN_WINDOW_DAYS=14

# Prometheus endpoint /internal/metrics (disabled when empty)
METRICS_TOKEN=

# Data retention for delivery-plumbing tables (days)
RETENTION_OUTBOX_DAYS=14
RETENTION_IDEMPOTENCY_DAYS=30
RETENTION_INBOX_DAYS=30
RETENTION_MESSAGE_DAYS=90
# Kafka event feed through a REST proxy (Confluent REST Proxy, Redpanda, Strimzi bridge)
KAFKA_RELAY_ENABLED=false
KAFKA_REST_URL=
KAFKA_REST_USER=
KAFKA_REST_PASSWORD=
KAFKA_TOPIC_PREFIX=
KAFKA_REST_TIMEOUT_MS=8000
# Language-model help for chats the rules do not understand (OpenAI-compatible, read-only actions only)
AGENT_LLM_ENABLED=false
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
AGENT_LLM_TIMEOUT_MS=
# Carrier tracking: poll parcels that had no scan for this long; link shown to customers ({tracking} is replaced)
TRACKING_POLL_STALE_SECONDS=900
CARRIER_TRACKING_URL_TEMPLATE=
# Exact J&T status codes -> platform status, e.g. {"SIGNED":"DELIVERED"}
JT_STATUS_MAP_JSON=
# Warehouse that consumes raw material (enables MRP transfer suggestions); overridable in /admin/settings
MRP_DEMAND_WAREHOUSE=
# Production refuses to start with default secrets; set true only in an emergency
SKIP_SECRET_CHECK=false
